# ai-service
TOXIC_THRESHOLD=0.90
MIN_LENGTH=10
MODELNAME=modelname

# backend
# DB_URL y AI_SERVICE_URL son para ejecutar el backend fuera de Docker (mvnw spring-boot:run).
# Con docker compose se ignoran: dentro de Docker los servicios se llaman por su nombre.
DB_URL=jdbc:postgresql://localhost:5432/reviews
DB_USER=reviews_user
DB_PASSWORD=cambia_esto
AI_SERVICE_URL=http://localhost:8000

# docker compose: puertos de la aplicación en tu máquina (opcionales; estos son los de por defecto).
# Cámbialos si ya tienes algo en 4200 u 8080, por ejemplo ng serve o mvnw spring-boot:run.
# FRONTEND_PORT=4200
# BACKEND_PORT=8080
